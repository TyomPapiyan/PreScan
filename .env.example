# PreScan API key names — EXAMPLE ONLY. Do not put real values here.
#
# At runtime, keys are read from the OS keyring (service name "prescan",
# username = provider id), NOT from a .env file (spec §10.5, §14). This file
# documents which providers exist and their key identifiers. Copy to .env only
# for local experiments; .env is git-ignored and never shipped.

# VirusTotal (free tier: non-commercial use only)
PRESCAN_VIRUSTOTAL_API_KEY=

# OPSWAT MetaDefender
PRESCAN_METADEFENDER_API_KEY=

# abuse.ch MalwareBazaar
PRESCAN_MALWAREBAZAAR_API_KEY=

# Google Safe Browsing (free tier: non-commercial use only)
PRESCAN_SAFEBROWSING_API_KEY=

# urlscan.io
PRESCAN_URLSCAN_API_KEY=
